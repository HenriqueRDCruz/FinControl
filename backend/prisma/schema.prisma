// ============================================================================
// MVP — Dashboard Financeiro Pessoal — Schema do Banco de Dados
// ============================================================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String    @map("password_hash")
  emailVerified   Boolean   @default(false) @map("email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  incomes                  Income[]
  expenses                 Expense[]
  creditCards              CreditCard[]
  investments              Investment[]
  netWorthSnapshots        NetWorthSnapshot[]
  refreshTokens            RefreshToken[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  userAgent String?  @map("user_agent")
  ip        String?
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

enum IncomeSource {
  SALARY
  FREELANCE
  INVESTMENT_INCOME
  GIFT
  OTHER
}

model Income {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal      @db.Decimal(18, 2)
  source      IncomeSource @default(OTHER)
  date        DateTime     @db.Date
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([userId, date])
  @@map("incomes")
}

enum ExpenseCategory {
  HOUSING
  FOOD
  TRANSPORT
  HEALTH
  EDUCATION
  LEISURE
  SUBSCRIPTIONS
  TAXES
  OTHER
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
}

model Expense {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal         @db.Decimal(18, 2)
  category    ExpenseCategory @default(OTHER)
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  date        DateTime        @db.Date

  creditCardId      String?     @map("credit_card_id")
  creditCard        CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  installmentNumber Int?        @map("installment_number")
  installmentCount  Int?        @map("installment_count")
  installmentGroupId String?    @map("installment_group_id")
  invoiceMonth      Int?        @map("invoice_month")
  invoiceYear       Int?        @map("invoice_year")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, date])
  @@index([creditCardId, invoiceYear, invoiceMonth])
  @@map("expenses")
}

model CreditCard {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  limitAmount Decimal  @map("limit_amount") @db.Decimal(18, 2)
  closingDay  Int      @map("closing_day")
  dueDay      Int      @map("due_day")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@index([userId])
  @@map("credit_cards")
}

enum InvestmentType {
  STOCK
  ETF
  REIT
  FIXED_INCOME
  FUND
  CRYPTO
  OTHER
}

model Investment {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           InvestmentType
  name           String
  institution    String?
  investedAmount Decimal        @map("invested_amount") @db.Decimal(18, 2)
  currentValue   Decimal        @map("current_value") @db.Decimal(18, 2)
  archived       Boolean        @default(false)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([userId])
  @@map("investments")
}

model NetWorthSnapshot {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  totalIncome      Decimal @map("total_income") @db.Decimal(18, 2)
  totalExpenses    Decimal @map("total_expenses") @db.Decimal(18, 2)
  totalInvestments Decimal @map("total_investments") @db.Decimal(18, 2)
  netWorth         Decimal @map("net_worth") @db.Decimal(18, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, date])
  @@index([userId, date])
  @@map("net_worth_snapshots")
}
