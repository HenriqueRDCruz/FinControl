generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoMovimentacao {
  RECEITA
  DESPESA
}

model Categoria {
  id           Int            @id @default(autoincrement())
  nome         String         @unique
  tipo         TipoMovimentacao
  cor          String         @default("#2563eb")
  createdAt    DateTime       @default(now())
  movimentacoes Movimentacao[]
}

model Movimentacao {
  id          Int              @id @default(autoincrement())
  descricao   String
  valor       Decimal          @db.Decimal(12, 2)
  data        DateTime
  tipo        TipoMovimentacao
  categoriaId Int
  categoria   Categoria        @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([data])
  @@index([tipo])
  @@index([categoriaId])
}

model Investimento {
  id            Int      @id @default(autoincrement())
  nome          String
  valorInvestido Decimal @db.Decimal(12, 2)
  valorAtual    Decimal  @db.Decimal(12, 2)
  data          DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([data])
}
